# Copy to .env.staging / .env.production and fill in. Everything here ships inside
# the app binary and is PUBLIC: no service keys, no private signing keys.

# Go backend (kwala-intel-app): /auth/me, /auth/me/context, /billing/plans
API_BASE_URL=
# Chat service: POST /api/sessions, GET /api/sessions/:id/messages, POST /api/chat/:id (SSE)
AI_API_BASE_URL=
# Supabase project used for email and phone OTP sign-in (the anon key is public by design)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Web app origin, used for legal links and as the checkout fallback on builds without Razorpay
WEB_BASE_URL=https://app.kwalaintel.com
# Development only. Must be "false" (or empty) for staging and production builds.
USE_MOCK_BACKEND=false
# Razorpay publishable key id (rzp_test_... / rzp_live_...) for the in-app checkout. The key
# id only, NEVER the key secret. Must belong to the same Razorpay account and mode as the
# backend's BILLING_PROVIDER_KEY_ID. Empty: use the key the backend sends with the intent.
# Production builds ignore an rzp_test_ key.
RAZORPAY_KEY_ID=
# Google OAuth client ids (public). The WEB client id is what the native Google sign-in requests a
# token for; Supabase's Google provider must list it (plus the Android/iOS ids) under Client IDs.
# Leave GOOGLE_WEB_CLIENT_ID empty to use the browser sign-in instead. The iOS id is iOS only.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
